function run(argv) {
  var modeName = argv[0];
  var verb = argv[1] === 'disable' ? 'Disable' : 'Enable';
  var app = Application.currentApplication();
  app.includeStandardAdditions = true;

  var sanitized = modeName.replace(/'/g, '');
  app.doShellScript("/usr/bin/shortcuts run '" + verb + " " + sanitized + "'");
  return verb + ' focus: ' + sanitized;
}
