function run(argv) {
  var appName = argv[0];
  var urlArg  = argv[1] || null;

  if (appName === "Finder") {
    var finder = Application("Finder");
    finder.activate();
    var folderArg = (urlArg && urlArg.indexOf("/") === 0) ? urlArg : null;
    if (folderArg) {
      var sysApp = Application.currentApplication();
      sysApp.includeStandardAdditions = true;
      var safeF = folderArg.replace(/'/g, "'\\''");
      try {
        sysApp.doShellScript("open '" + safeF + "'");
      } catch(e) {
        try { finder.open(Path(folderArg)); } catch(e2) {}
      }
    }
    return "Processed Finder";
  }

  if (appName === "Terminal" && urlArg && !urlArg.match(/^https?:\/\//i)) {
    try {
      var terminalApp = Application("Terminal");
      var safe = urlArg.replace(/'/g, "'\\''");
      var newWindow = terminalApp.doScript("clear");
      terminalApp.doScript("cd '" + safe + "'", { in: newWindow });
      terminalApp.activate();
      return "Processed Terminal";
    } catch(e) {
      var sysApp2 = Application.currentApplication();
      sysApp2.includeStandardAdditions = true;
      var safe2 = urlArg.replace(/'/g, "'\\''");
      sysApp2.doShellScript("open -a Terminal '" + safe2 + "'");
      return "Processed Terminal";
    }
  }

  if (appName === "Notion" && urlArg && urlArg.indexOf("notion://") === 0) {
    var sysApp = Application.currentApplication();
    sysApp.includeStandardAdditions = true;
    var safe = urlArg.replace(/'/g, "'\\''");
    sysApp.doShellScript("open -a 'Notion' '" + safe + "'");
    return "Processed Notion";
  }

  if (appName === "Slack" && urlArg) {
    var sysApp = Application.currentApplication();
    sysApp.includeStandardAdditions = true;
    var safe = urlArg.replace(/'/g, "'\\''");
    sysApp.doShellScript("open -a 'Slack' '" + safe + "'");
    return "Processed Slack";
  }

  if (appName === "Obsidian") {
    var sysApp = Application.currentApplication();
    sysApp.includeStandardAdditions = true;
    if (urlArg && urlArg.indexOf("obsidian://") === 0) {
      var safe = urlArg.replace(/'/g, "'\\''");
      sysApp.doShellScript("open '" + safe + "'");
    } else {
      sysApp.doShellScript("open -a 'Obsidian'");
    }
    return "Processed Obsidian";
  }

  if (appName === "Figma" && urlArg) {
    var sysApp = Application.currentApplication();
    sysApp.includeStandardAdditions = true;
    var safe = urlArg.replace(/'/g, "'\\''");
    sysApp.doShellScript("open -a 'Figma' '" + safe + "'");
    return "Processed Figma";
  }

  if (appName === "PDFgear") {
    var sysApp = Application.currentApplication();
    sysApp.includeStandardAdditions = true;
    var potentialUrlArg = argv[1] || "";
    var fileArg = argv[2] || null;
    if (!fileArg && potentialUrlArg && potentialUrlArg.indexOf("/") === 0) {
      fileArg = potentialUrlArg;
    }
    if (fileArg && typeof fileArg === "string" && !fileArg.match(/^https?:\/\//i)) {
      var safe = fileArg.replace(/'/g, "'\\''");
      sysApp.doShellScript("open -a 'PDFgear' '" + safe + "'");
    } else {
      sysApp.doShellScript("open -a 'PDFgear'");
    }
    return "Processed PDFgear";
  }

  if (appName === "Preview") {
    var sysApp = Application.currentApplication();
    sysApp.includeStandardAdditions = true;
    var potentialUrlArg = argv[1] || "";
    var fileArg = argv[2] || null;
    if (!fileArg && potentialUrlArg && potentialUrlArg.indexOf("/") === 0) {
      fileArg = potentialUrlArg;
    }
    if (fileArg && typeof fileArg === "string" && !fileArg.match(/^https?:\/\//i)) {
      var safe = fileArg.replace(/'/g, "'\\''");
      try {
        sysApp.doShellScript("open -a 'Preview' '" + safe + "'");
      } catch(e) {
        try {
          var previewApp = Application("Preview");
          previewApp.open(fileArg);
          previewApp.activate();
        } catch(e2) {
          sysApp.doShellScript("open -a 'Preview' '" + safe + "'");
        }
      }
    } else {
      sysApp.doShellScript("open -a 'Preview'");
    }
    return "Processed Preview";
  }

  if (appName === "Code") {
    var sysApp = Application.currentApplication();
    sysApp.includeStandardAdditions = true;
    var fileArg = argv[2] || null;
    if (fileArg && !fileArg.match(/^https?:\/\//i)) {
      var safeFile = fileArg.replace(/'/g, "'\\''");
      sysApp.doShellScript("open -a 'Visual Studio Code' '" + safeFile + "'");
    } else if (urlArg && !urlArg.match(/^https?:\/\//i)) {
      var safe = urlArg.replace(/'/g, "'\\''");
      sysApp.doShellScript("open -a 'Visual Studio Code' '" + safe + "'");
    } else {
      sysApp.doShellScript("open -a 'Visual Studio Code'");
    }
    return "Processed Code";
  }

  var app = Application(appName);
  app.includeStandardAdditions = true;

  var wasRunning = app.running(); // capture BEFORE activate changes state
  if (!wasRunning) {
    app.activate();
  } else {
    try {
      app.activate();
      delay(0.1);
      app.reopen();
    } catch(e) {}

    var se = Application('System Events');
    try {
      var proc = se.processes.byName(appName);
      proc.frontmost = true;
      var wins = proc.windows();
      for (var i = 0; i < wins.length; i++) {
        try {
          if (wins[i].attributes.byName('AXMinimized').value() === true) {
            wins[i].attributes.byName('AXMinimized').value = false;
          }
        } catch(e) {}
      }
      if (wins.length > 0) {
        try { wins[0].actions.byName('AXRaise').perform(); } catch(e) {}
      }
    } catch(e) {}
  }

  if (appName === "Spotify" && urlArg && urlArg.indexOf("spotify:") === 0) {
    if (!wasRunning) delay(2);
    else delay(0.3);
    try {
      app.playTrack(urlArg);
    } catch(e) { /* playTrack unavailable — Spotify still opened */ }
    return "Processed Spotify";
  }

  var browsers = ["Google Chrome", "Safari", "Arc"];
  if (browsers.indexOf(appName) !== -1 && urlArg) {
    if (!wasRunning) delay(1.5); // cold boot: wait for window layer to appear
    else delay(0.5);

    if (app.windows.length === 0) app.Document().make();

    var targetWindow = app.windows[0];
    var tabs = Object.values(targetWindow.tabs());
    var found = false;

    for (var i = 0; i < tabs.length; i++) {
      try {
        if (tabs[i].url() === urlArg) {
          targetWindow.activeTab = tabs[i];
          found = true;
          break;
        }
      } catch(e) { /* skip detached tab */ }
    }

    if (!found) {
      targetWindow.tabs.push(app.Tab({ url: urlArg }));
    }
  }

  return "Processed " + appName;
}
