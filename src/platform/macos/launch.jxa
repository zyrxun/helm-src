function run(argv) {
  var appName = argv[0];
  var urlArg  = argv[1] || null;

  if (appName === "Terminal" && urlArg && !urlArg.match(/^https?:\/\//i)) {
    try {
      var terminalApp = Application("Terminal");
      var safe = urlArg.replace(/'/g, "'\\''");
      var newWindow = terminalApp.doScript("clear");
      terminalApp.doScript("cd '" + safe + "'", { in: newWindow });
      terminalApp.activate();
      return "Processed Terminal";
    } catch(e) {
      var sysApp2 = Application.currentApplication();
      sysApp2.includeStandardAdditions = true;
      var safe2 = urlArg.replace(/'/g, "'\\''");
      sysApp2.doShellScript("open -a Terminal '" + safe2 + "'");
      return "Processed Terminal";
    }
  }

  if (appName === "Notion" && urlArg && urlArg.indexOf("notion://") === 0) {
    var sysApp = Application.currentApplication();
    sysApp.includeStandardAdditions = true;
    var safe = urlArg.replace(/'/g, "'\\''");
    sysApp.doShellScript("open -a 'Notion' '" + safe + "'");
    return "Processed Notion";
  }

  if (appName === "Slack" && urlArg) {
    var sysApp = Application.currentApplication();
    sysApp.includeStandardAdditions = true;
    var safe = urlArg.replace(/'/g, "'\\''");
    sysApp.doShellScript("open -a 'Slack' '" + safe + "'");
    return "Processed Slack";
  }

  if (appName === "Figma" && urlArg) {
    var sysApp = Application.currentApplication();
    sysApp.includeStandardAdditions = true;
    var safe = urlArg.replace(/'/g, "'\\''");
    sysApp.doShellScript("open -a 'Figma' '" + safe + "'");
    return "Processed Figma";
  }

  if (appName === "Code" && urlArg && !urlArg.match(/^https?:\/\//i)) {
    var sysApp = Application.currentApplication();
    sysApp.includeStandardAdditions = true;
    var safe = urlArg.replace(/'/g, "'\\''");
    sysApp.doShellScript("open -a 'Visual Studio Code' '" + safe + "'");
    return "Processed Code";
  }

  var app = Application(appName);
  app.includeStandardAdditions = true;

  var wasRunning = app.running(); // capture BEFORE activate changes state
  app.activate();

  if (appName === "Spotify" && urlArg && urlArg.indexOf("spotify:") === 0) {
    if (!wasRunning) delay(2);
    else delay(0.3);
    try {
      app.playTrack(urlArg);
    } catch(e) { /* playTrack unavailable — Spotify still opened */ }
    return "Processed Spotify";
  }

  var browsers = ["Google Chrome", "Safari", "Arc"];
  if (browsers.indexOf(appName) !== -1 && urlArg) {
    if (!wasRunning) delay(1.5); // cold boot: wait for window layer to appear
    else delay(0.5);

    if (app.windows.length === 0) app.Document().make();

    var targetWindow = app.windows[0];
    var tabs = Object.values(targetWindow.tabs());
    var found = false;

    for (var i = 0; i < tabs.length; i++) {
      try {
        if (tabs[i].url() === urlArg) {
          targetWindow.activeTab = tabs[i];
          found = true;
          break;
        }
      } catch(e) { /* skip detached tab */ }
    }

    if (!found) {
      targetWindow.tabs.push(app.Tab({ url: urlArg }));
    }
  }

  return "Processed " + appName;
}
