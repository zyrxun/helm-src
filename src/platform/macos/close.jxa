function run(argv) {
  var appName = argv[0];
  var urlArg  = argv[1]; // optional — browser tab URL to close
  var profileArg = argv[2] || null; // optional Chrome profile dir
  var winTitlesArg = argv[3] || null; // optional \x1f-separated window titles in target profile

  var browsers = ["Google Chrome", "Safari", "Arc"];

  if (urlArg && browsers.indexOf(appName) !== -1) {
    var browser = Application(appName);
    if (!browser.running()) {
      return "Browser not running";
    }

    var targetOrigin = urlArg.replace(/^(https?:\/\/[^\/]+).*/, '$1');
    var closed = false;
    var isSafari = (appName === "Safari");

    // Resolve which windows belong to the target profile. Best signal is the
    // exact title list provided by main.js (from the native AX helper).
    // If absent, fall back to title-suffix matching against the profile's
    // display name. If neither yields any windows, scan all (legacy behavior).
    var profileWindowIds = null;
    if (profileArg && appName === "Google Chrome") {
      var allWins = browser.windows();
      var titleSet = null;
      if (winTitlesArg) {
        titleSet = {};
        var parts = String(winTitlesArg).split(String.fromCharCode(31));
        for (var ti = 0; ti < parts.length; ti++) {
          if (parts[ti]) titleSet[parts[ti]] = true;
        }
      }
      if (titleSet) {
        profileWindowIds = {};
        var matched1 = false;
        for (var w1 = 0; w1 < allWins.length; w1++) {
          try {
            if (titleSet[String(allWins[w1].name() || "")]) {
              profileWindowIds[String(allWins[w1].id())] = true;
              matched1 = true;
            }
          } catch(e) {}
        }
        if (!matched1) profileWindowIds = null;
      }
      if (!profileWindowIds) {
      try {
        var sysAppC = Application.currentApplication();
        sysAppC.includeStandardAdditions = true;
        var rawLS = sysAppC.doShellScript(
          "cat ~/Library/Application\\ Support/Google/Chrome/Local\\ State 2>/dev/null || echo '{}'"
        );
        var lsData = JSON.parse(rawLS);
        var cache = (lsData.profile && lsData.profile.info_cache) || {};
        var displayName = cache[profileArg] && cache[profileArg].name;
        if (displayName) {
          var esc = String(displayName).replace(/[-\/\\^$*+?.()|[\]{}]/g, "\\$&");
          var matchRe = new RegExp(" - " + esc + "$");
          profileWindowIds = {};
          var anyMatched = false;
          for (var pwi = 0; pwi < allWins.length; pwi++) {
            try {
              if (matchRe.test(String(allWins[pwi].name() || ""))) {
                profileWindowIds[String(allWins[pwi].id())] = true;
                anyMatched = true;
              }
            } catch(e) {}
          }
          if (!anyMatched) profileWindowIds = null; // graceful fall-through
        }
      } catch(e) { profileWindowIds = null; }
      } // end if (!profileWindowIds) — title-suffix fallback
    }

    function windowAllowed(win) {
      if (!profileWindowIds) return true;
      try { return !!profileWindowIds[String(win.id())]; } catch(e) { return false; }
    }

    // Strategy 1: exact URL match (within allowed windows when profile is set)
    outerExact: for (var w = 0; w < browser.windows.length; w++) {
      if (!windowAllowed(browser.windows[w])) continue;
      var tabs = browser.windows[w].tabs;
      for (var t = 0; t < tabs.length; t++) {
        var tabUrl = isSafari ? tabs[t].URL() : tabs[t].url();
        if (tabUrl === urlArg) {
          tabs[t].close();
          closed = true;
          break outerExact;
        }
      }
    }

    // Strategy 2: same-origin fallback (within allowed windows when profile is set)
    if (!closed) {
      outerOrigin: for (var w2 = 0; w2 < browser.windows.length; w2++) {
        if (!windowAllowed(browser.windows[w2])) continue;
        var tabs2 = browser.windows[w2].tabs;
        for (var t2 = 0; t2 < tabs2.length; t2++) {
          var u = (isSafari ? tabs2[t2].URL() : tabs2[t2].url()) || '';
          if (u.indexOf(targetOrigin) === 0) {
            tabs2[t2].close();
            closed = true;
            break outerOrigin;
          }
        }
      }
    }

    return closed ? "Closed tab: " + urlArg : "No matching tab found";
  }

  // Non-browser apps
  var targetApp = Application(appName);
  if (!targetApp.running()) {
    return "Not running";
  }

  // Apps that need Cmd+S before quit to avoid losing unsaved work
  var saveBeforeQuit = [
    "Code", "Visual Studio Code",           // VS Code
    "Microsoft Word", "Microsoft Excel", "Microsoft PowerPoint",  // Office
    "Pages", "Numbers", "Keynote",          // iWork
    "Notion",                               // Notion desktop
    "Obsidian",                             // Obsidian
    "BBEdit", "TextEdit", "Sublime Text",   // Text editors
  ];

  if (saveBeforeQuit.indexOf(appName) !== -1) {
    try {
      targetApp.activate();
      delay(0.3);
      var se = Application("System Events");
      se.keystroke("s", { using: ["command down"] });
      delay(0.3);
    } catch (e) {}
  }

  targetApp.quit();
  return "Quit " + appName;
}
