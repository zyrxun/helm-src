var app = Application.currentApplication();
app.includeStandardAdditions = true;

function run() {
  var se = Application("System Events");
  var result = { apps: [] };

  var procs = se.processes.whose({ backgroundOnly: false, visible: true });
  var names = Object.values(procs.name());

  var browserNames = ["Google Chrome", "Safari", "Arc", "Firefox"];
  var skip = [
    "Dock", "SystemUIServer", "Control Center",
    "WindowServer", "loginwindow", "NotificationCenter", "Spotlight",
    "Alfred", "Raycast", "Activity Monitor"
  ];

  names.forEach(function(name) {
    if (name === "Terminal") {
      try {
        var term = Application("Terminal");
        if (term.running()) {
          term.windows().forEach(function(win) {
            win.tabs().forEach(function(tab) {
              try {
                var ttyName = tab.tty();
                if (!ttyName) return;
                var cleanTty = ttyName.replace("/dev/", "");
                // Find the deepest interactive shell on this TTY (pgid==pid, shell command)
                var shellPid = app.doShellScript(
                  "ps -t " + cleanTty + " -o pid=,pgid=,comm= 2>/dev/null | awk '$1==$2 && ($3~/bash|zsh|fish|^sh$/) {last=$1} END {print last}'"
                ).trim();
                if (shellPid) {
                  var cwd = app.doShellScript(
                    "lsof -a -p " + shellPid + " -d cwd -Fn 2>/dev/null | grep '^n' | sed 's/^n//'"
                  ).trim();
                  if (cwd) result.apps.push({ name: "Terminal", folderPath: String(cwd) });
                }
              } catch(e) {}
            });
          });
        }
      } catch(e) {
        result.apps.push({ name: "Terminal" });
      }
      return;
    }

    if (name === "Notion") {
      try {
        if (se.processes.whose({ name: "Notion" }).length > 0) {
          var notionWins = se.processes["Notion"].windows();
          var pushed = false;
          notionWins.forEach(function(win) {
            // Get title first — works even when attributes are sandboxed
            var title = null;
            try { title = win.name(); } catch(e) {}

            // Try accessibility URL attributes
            var urlPayload = null;
            try {
              if (win.attributes.whose({ name: "AXDocument" }).length > 0)
                urlPayload = win.attributes["AXDocument"].value();
              if (!urlPayload && win.attributes.whose({ name: "AXURL" }).length > 0)
                urlPayload = win.attributes["AXURL"].value();
            } catch(e) {}

            if (urlPayload && String(urlPayload).indexOf("notion.so") !== -1) {
              var deepLink = String(urlPayload).replace(/^https?:\/\/www\.notion\.so/, "notion://www.notion.so");
              result.apps.push({ name: "Notion", urlToOpen: deepLink });
              pushed = true;
            } else if (title && title !== "Notion") {
              result.apps.push({
                name: "Notion",
                urlToOpen: "notion://www.notion.so/",
                labelFallback: title.replace(" - Notion", "").trim()
              });
              pushed = true;
            }
          });
          if (!pushed) result.apps.push({ name: "Notion" });
        }
      } catch(e) {
        result.apps.push({ name: "Notion" });
      }
      return;
    }

    if (name === "Spotify") {
      try {
        var spot = Application("Spotify");
        if (spot.running()) {
          var uri = null, spotLabel = null;
          try {
            var track = spot.currentTrack;
            uri      = track.spotifyUrl();
            spotLabel = track.name() + " — " + track.artist();
          } catch(e) {}
          result.apps.push({ name: "Spotify", urlToOpen: uri || undefined, label: spotLabel || undefined });
        }
      } catch(e) {}
      return;
    }

    if (name === "PDFgear") {
      try {
        var pdfgearPids = app.doShellScript(
          "pgrep -x PDFgear 2>/dev/null || true"
        ).trim();
        if (pdfgearPids) {
          var pidArgs = pdfgearPids.split(/\s+/).map(function(p) { return "-p " + p; }).join(" ");
          var pdfFiles = app.doShellScript(
            "lsof " + pidArgs + " 2>/dev/null | awk '{print $NF}' | grep -i '\\.pdf$' | sort -u"
          ).trim();
          if (pdfFiles) {
            pdfFiles.split("\r").forEach(function(filePath) {
              filePath = filePath.trim();
              if (!filePath || filePath.indexOf("/") !== 0) return; // skip relative paths
              var label = filePath.split("/").pop() || "PDF";
              result.apps.push({ name: "PDFgear", filePath: filePath, label: label });
            });
          } else {
            result.apps.push({ name: "PDFgear" });
          }
        }
      } catch(e) {
        result.apps.push({ name: "PDFgear" });
      }
      return;
    }

    if (name === "Preview") {
      try {
        var preview = Application("Preview");
        if (preview.running()) {
          var pushed = false;
          var docsArray = [];
          try {
            docsArray = Array.prototype.slice.call(preview.documents());
          } catch(e) {
            var totalDocs = 0;
            try { totalDocs = preview.documents().length; } catch(err) {}
            for (var d = 0; d < totalDocs; d++) {
              try { docsArray.push(preview.documents[d]); } catch(err) {}
            }
          }
          docsArray.forEach(function(doc) {
            try {
              if (!doc) return;
              var rawRef = doc.file();
              if (rawRef === null || typeof rawRef === "undefined") return;
              var posixPath = null;
              if (typeof rawRef.posixPath === "function") {
                posixPath = rawRef.posixPath();
              } else if (doc.path) {
                try { posixPath = doc.path(); } catch(e) {}
              }
              if (!posixPath || String(posixPath).indexOf("[object") !== -1) return;
              var label = "PDF";
              try { label = String(doc.name() || "PDF"); } catch(e) {}
              result.apps.push({ name: "Preview", filePath: String(posixPath).trim(), label: label });
              pushed = true;
            } catch(e) {}
          });
          if (!pushed) result.apps.push({ name: "Preview" });
        }
      } catch(e) {
        result.apps.push({ name: "Preview" });
      }
      return;
    }

    if (name === "Slack") {
      // Deep link is enriched by main.js via slack_state.py after capture returns
      result.apps.push({ name: "Slack" });
      return;
    }

    if (name === "Obsidian") {
      try {
        var obsJson = app.doShellScript(
          "cat ~/Library/Application\\ Support/obsidian/obsidian.json 2>/dev/null || echo '{}'"
        ).trim();
        var obsData = JSON.parse(obsJson);
        var obsVaults = obsData.vaults || {};
        var openVault = null;
        Object.keys(obsVaults).forEach(function(vid) {
          if (obsVaults[vid].open) openVault = obsVaults[vid];
        });
        var vaultName = openVault ? openVault.path.split("/").pop() : null;

        var noteLabel = null;
        try {
          var obsProc = se.processes.whose({ name: "Obsidian" })[0];
          var obsWins = obsProc.windows();
          if (obsWins.length > 0) {
            var obsTitle = String(obsWins[0].name() || "");
            // Title format: "Note Name - Vault Name - Obsidian" or "Note Name - Obsidian"
            var obsParts = obsTitle.split(" - ");
            if (obsParts.length >= 2 && obsParts[obsParts.length - 1].trim() === "Obsidian") {
              noteLabel = obsParts[0].trim();
              if (!vaultName && obsParts.length >= 3) vaultName = obsParts[1].trim();
            }
          }
        } catch(e) {}

        var obsUrl = null;
        if (vaultName && noteLabel) {
          obsUrl = "obsidian://open?vault=" + encodeURIComponent(vaultName) + "&file=" + encodeURIComponent(noteLabel);
        } else if (vaultName) {
          obsUrl = "obsidian://open?vault=" + encodeURIComponent(vaultName);
        }

        result.apps.push({
          name: "Obsidian",
          urlToOpen: obsUrl || undefined,
          label: noteLabel || vaultName || undefined
        });
      } catch(e) {
        result.apps.push({ name: "Obsidian" });
      }
      return;
    }

    if (name === "Figma") {
      result.apps.push({ name: "Figma" });
      return;
    }

    if (name === "Code") {
      // Open files are enriched by main.js via vscode_state.py after capture returns
      result.apps.push({ name: "Code" });
      return;
    }

    if (name === "Finder") {
      try {
        var finder = Application("Finder");
        var wins = finder.windows();
        var pushed = false;
        for (var fi = 0; fi < wins.length; fi++) {
          try {
            var target = wins[fi].target();
            var url = target.url();
            if (!url || url.indexOf("file://") !== 0) continue;
            var folderPath = decodeURIComponent(url.replace(/^file:\/\//, "")).replace(/\/$/, "");
            if (!folderPath) continue;
            result.apps.push({ name: "Finder", folderPath: folderPath });
            pushed = true;
          } catch(e) {}
        }
        if (!pushed) result.apps.push({ name: "Finder" });
      } catch(e) {
        result.apps.push({ name: "Finder" });
      }
      return;
    }

    if (browserNames.indexOf(name) !== -1) {
      try {
        var browser = Application(name);
        if (browser.running()) {
          if (name !== "Firefox") {
            var wins = browser.windows();
            wins.forEach(function(win) {
              try {
                // Invoke specifier as function → resolves to native array in one IPC pass
                var urls = win.tabs.url();
                if (urls && urls.length) {
                  for (var i = 0; i < urls.length; i++) {
                    var url = urls[i];
                    if (url && url !== "missing value" && typeof url === "string") {
                      result.apps.push({ name: name, urlToOpen: url });
                    }
                  }
                }
              } catch(e) { /* skip unresponsive window */ }
            });
          } else {
            result.apps.push({ name: name });
          }
        }
      } catch(e) {
        result.apps.push({ name: name });
      }
    } else if (skip.indexOf(name) === -1) {
      result.apps.push({ name: name });
    }
  });

  return JSON.stringify(result);
}
