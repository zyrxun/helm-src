{
  "name": "helm",
  "productName": "Helm",
  "version": "1.0.3",
  "description": "Menu bar workflow orchestrator for macOS and Windows",
  "author": "zyrxun",
  "main": "electron/main.js",
  "scripts": {
    "build": "tsc && mkdir -p dist/jxa && cp src/platform/macos/*.jxa dist/jxa/",
    "build-helper": "bash scripts/chrome-profile-probe/build.sh",
    "menu-bar": "npm run build-helper && tsc && electron electron/main.js",
    "menu-bar:win": "tsc && electron electron/main.js",
    "pack": "npm run build-helper && electron-builder --mac",
    "pack:win": "tsc && electron-builder --win",
    "release": "npm run build-helper && electron-builder --mac --publish always",
    "release:win": "tsc && electron-builder --win --publish always",
    "build-icon": "bash scripts/build-icon.sh"
  },
  "build": {
    "appId": "com.helm.app",
    "productName": "Helm",
    "publish": {
      "provider": "github",
      "owner": "zyrxun",
      "repo": "helm-releases"
    },
    "asar": true,
    "compression": "maximum",
    "files": [
      "electron/**/*",
      "public/**/*",
      "package.json",
      "!public/**/*.mov",
      "!public/**/*.mp4",
      "!**/*.map",
      "!**/*.ts",
      "!**/*.md",
      "!**/.DS_Store",
      "!**/node_modules/*/{CHANGELOG.md,README.md,readme.md,README,readme,HISTORY.md,*.markdown}",
      "!**/node_modules/*/{test,tests,__tests__,powered-test,example,examples,docs,doc,.github}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin",
      "!**/node_modules/**/{*.cc,*.h,*.gyp,*.gypi,binding.gyp,Makefile,*.mk}",
      "native/profile-probe/index.js",
      "native/profile-probe/package.json",
      "native/profile-probe/build/Release/*.node"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "public/brand/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "x64ArchFiles": "Contents/Resources/bin/*",
      "extraResources": [
        {
          "from": "src/platform/macos",
          "to": "jxa",
          "filter": [
            "*.jxa"
          ]
        },
        {
          "from": "scripts/chrome-profile-probe/bin",
          "to": "bin",
          "filter": [
            "chrome-profile-probe"
          ]
        }
      ]
    },
    "win": {
      "icon": "public/brand/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "src/platform/windows",
          "to": "win",
          "filter": [
            "*.ps1"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Helm",
      "deleteAppDataOnUninstall": false,
      "artifactName": "${productName}-${version}-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-${arch}-portable.${ext}"
    },
    "dmg": {
      "background": "public/brand/dmg-background.png",
      "iconSize": 128,
      "contents": [
        {
          "x": 130,
          "y": 220,
          "type": "file"
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "afterSign": "scripts/notarize.js",
    "afterAllArtifactBuild": "scripts/after-artifact-build.js",
    "asarUnpack": [
      "native/profile-probe/build/Release/*.node"
    ]
  },
  "devDependencies": {
    "@electron/notarize": "^2.5.0",
    "@types/node": "^20.0.0",
    "electron": "^42.3.0",
    "electron-builder": "^25.0.0",
    "node-gyp": "^12.4.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "dotenv": "^16.0.0",
    "electron-updater": "^6.8.3",
    "profile-probe": "file:./native/profile-probe"
  }
}